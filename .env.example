# ==============================================================================
# PulseForge Master Environment Configuration (.env.example)
# Copy this file to .env and adjust credentials for your environment.
# ==============================================================================

# Runtime Environment (development | test | production)
APP_ENV=development

# ------------------------------------------------------------------------------
# API & Worker HTTP Server Configuration
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_GRACEFUL_TIMEOUT=10s

# ------------------------------------------------------------------------------
# Primary Database (PostgreSQL 16 + TimescaleDB Community Edition)
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://pulseforge:pulseforge_secret@localhost:5432/pulseforge?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=15m

# ------------------------------------------------------------------------------
# Cache, Session & Pub/Sub Backplane (Redis 7+)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ------------------------------------------------------------------------------
# High-Security Authentication Subsystem
# ------------------------------------------------------------------------------
# In production, AUTH_JWT_ACCESS_SECRET must be >= 32 cryptographically secure characters
AUTH_JWT_ACCESS_SECRET=dev_super_secret_jwt_access_key_min_32_bytes_long!
AUTH_JWT_ACCESS_TTL=15m
AUTH_JWT_REFRESH_TTL=168h
AUTH_WS_TICKET_TTL=30s
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# OAuth2 Identity Providers (Google & GitHub)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:8080/api/v1/auth/github/callback

# ------------------------------------------------------------------------------
# Logging Configuration (slog)
# ------------------------------------------------------------------------------
# LOG_LEVEL: debug | info | warn | error
LOG_LEVEL=info
# LOG_FORMAT: json | text
LOG_FORMAT=json

# ------------------------------------------------------------------------------
# Transactional Email & Support Notification Dispatch (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@pulseforge.local
SUPPORT_EMAIL=support@pulseforge.local

# ------------------------------------------------------------------------------
# Frontend Client Public Variables
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/v1/ws
